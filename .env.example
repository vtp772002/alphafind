# ==============================================================================
# WorldQuant BRAIN API Credentials & Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
#
# NOTE: Never commit your real .env file with passwords to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY RESEARCH ACCOUNT (Mandatory)
# ------------------------------------------------------------------------------
# Primary account used for candidate verification (8/8 PASS checks),
# official Out-of-Sample submission, and portfolio correlation auditing.
MAIN_ACCOUNT_EMAIL=your_email@example.com
MAIN_ACCOUNT_PASSWORD=your_password

# Alternative variable naming format:
# WQ_BRAIN_EMAIL=your_email@example.com
# WQ_BRAIN_PASSWORD=your_password

# ------------------------------------------------------------------------------
# 2. SECONDARY RESEARCH SESSIONS (Optional — Collaborative Team Pooling)
# ------------------------------------------------------------------------------
# Enables distributed multi-session worker pooling for research teams.

# Secondary Worker Session 1 (Optional):
SECONDARY_ACCOUNT_1_EMAIL=team_worker1@example.com
SECONDARY_ACCOUNT_1_PASSWORD=team_worker1_password

# Secondary Worker Session 2 (Optional):
SECONDARY_ACCOUNT_2_EMAIL=team_worker2@example.com
SECONDARY_ACCOUNT_2_PASSWORD=team_worker2_password
