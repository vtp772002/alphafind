# ==============================================================================
# WorldQuant BRAIN API Credentials & Configuration Template
# ==============================================================================
# Copy this file to .env, restrict its permissions, and fill in your credentials:
#   cp .env.example .env && chmod 600 .env
#
# NOTE: Never commit your real .env file with passwords to version control!
# Use only one BRAIN account controlled by the individual participant. Do not
# share account credentials or operate multiple accounts for one participant.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY RESEARCH ACCOUNT (Mandatory)
# ------------------------------------------------------------------------------
# Primary account used for simulations, fail-closed submission checks,
# Out-of-Sample submission, and local portfolio correlation auditing.
MAIN_ACCOUNT_EMAIL=your_email@example.com
MAIN_ACCOUNT_PASSWORD=your_password

# Enforce single-account mode by default (recommended per AGENTS.md):
ALPHAFIND_SINGLE_ACCOUNT=1

# Alternative variable naming format:
# WQ_BRAIN_EMAIL=your_email@example.com
# WQ_BRAIN_PASSWORD=your_password
